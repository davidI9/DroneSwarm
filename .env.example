# Configuración de red de esta máquina para la versión Zenoh.
#
# Copia este fichero a `.env` en la raíz del repositorio y rellénalo. La `.env`
# no se versiona. `scripts/zenoh_config.py` la lee y construye
# ZENOH_CONFIG_OVERRIDE para el router y para las sesiones de los nodos.
# Para ver la configuración resultante sin lanzar nada:
#
#   pixi run zenoh-config

# Papel de esta máquina:
#   cliente  portátil. Su router conecta al de la torre por Tailscale y los
#            nodos (mano falsa, vista del enjambre, RViz2) van en modo peer
#            contra el router local.
#   torre    host del servidor. Su router solo escucha en TCP 7447, en todas
#            las interfaces, y los nodos van en modo peer contra él.
#   vm       VM del servidor. No hay router: los drones van en modo client
#            contra el router del host, en TORRE_IP_VMS. Si ese router aún
#            no está, esperan a que arranque.
ROL=cliente

# IP de Tailscale de la torre, a la que conecta el router del cliente.
# Solo hace falta con ROL=cliente (`tailscale ip -4` en la torre).
TORRE_TAILSCALE_IP=100.64.0.1

# IP del host de la torre vista desde las VMs (red interna del hipervisor).
# Solo hace falta con ROL=vm.
TORRE_IP_VMS=192.168.122.1
